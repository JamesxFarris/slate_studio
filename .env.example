# Slate Studio environment variables.
# Copy this file to .env and fill in real values. Never commit .env.

# Anthropic API — console.anthropic.com
ANTHROPIC_API_KEY=

# Tavily search API — tavily.com
TAVILY_API_KEY=

# MongoDB Atlas connection string. Database name is part of the URI path.
# Format: mongodb+srv://<user>:<password>@<cluster-host>/slate_studio?retryWrites=true&w=majority&appName=<app>
# See KICKOFF.md for setup notes (scoped user, IP allowlist).
MONGODB_URI=

# Express session secret — generate with `openssl rand -hex 32`
SESSION_SECRET=

# Seeded single-user auth (v1). Backend seeds this account on first boot.
# Never use a real password you use elsewhere.
SEED_EMAIL=
SEED_PASSWORD=

# Backend server
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173

# Cost mode: 'development' defaults every agent to Haiku per COST_CONTROLS.md Rule 7.
# Set to 'production' to use per-agent model assignments.
NODE_ENV=development

# Log level: 'debug' | 'info' | 'warn' | 'error'
LOG_LEVEL=info
