# Slate Studio environment variables.
# Copy this file to .env and fill in real values. Never commit .env.

# Anthropic API — console.anthropic.com
ANTHROPIC_API_KEY=

# Tavily search API — tavily.com
TAVILY_API_KEY=

# MongoDB Atlas — reuses existing Cluster0; slate_studio database is created on first write.
# Replace <password> with the slate_studio user's password.
MONGODB_URI=mongodb+srv://jafarris:<password>@cluster0.ypo5wnh.mongodb.net/slate_studio?retryWrites=true&w=majority&appName=Cluster0

# Express session secret — generate a long random string (e.g. `openssl rand -hex 32`)
SESSION_SECRET=

# Backend server
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173

# Cost mode: 'development' defaults every agent to Haiku per COST_CONTROLS.md Rule 7.
# Set to 'production' to use per-agent model assignments.
NODE_ENV=development
